{
  "expo": {
    "name": "HUMSAFAR",
    "slug": "humsafar",
    "version": "1.0.0",
    "orientation": "portrait",
    "icon": "./assets/icon.png",
    "userInterfaceStyle": "light",
    "splash": {
      "image": "./assets/splash-icon.png",
      "resizeMode": "contain",
      "backgroundColor": "#2D0B59"
    },
    "ios": {
      "supportsTablet": true,
      "bundleIdentifier": "com.humsafar.app"
    },
    "android": {
      "adaptiveIcon": {
        "foregroundImage": "./assets/icon.png",
        "backgroundColor": "#2D0B59"
      },
      "package": "com.humsafar.app",
      "versionCode": 1,
      "predictiveBackGestureEnabled": false
    },
    "web": {
      "favicon": "./assets/favicon.png"
    },
    "plugins": [
      "expo-font"
    ],
    "extra": {
      "eas": {
        "projectId": "30f09912-a51e-471f-a2ab-fad51e9ee6f1"
      }
    },
    "owner": "mohdanas786"
  }
}
